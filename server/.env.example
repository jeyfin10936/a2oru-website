# Express contact API — copy to `.env` (local) or `.env.production` (UAT/production).
# Mail is sent by Strapi (Aithent-CMS .env SMTP), not this server.
# Never commit real `.env` files.

# --- App ---
FRONTEND_URL=
PORT=5000

# --- Strapi (A2ORU inquiries) ---
# Local: http://localhost:1337
# UAT:  https://uatweb.aithent.com/strapi
STRAPI_API_URL=
A2ORU_STRAPI_API_TOKEN=
# Optional; must match Aithent-CMS CONTACT_EMAIL_INTERNAL_SECRET
# CONTACT_EMAIL_INTERNAL_SECRET=